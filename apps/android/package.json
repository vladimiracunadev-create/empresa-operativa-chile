{
  "name": "empresa-operativa-android",
  "version": "1.5.0",
  "private": true,
  "description": "Envoltorio Capacitor que empaqueta apps/web/dist como aplicación Android",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.13.0 <27"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "prepare:www": "node ../../scripts/build-web.mjs && node ./copiar-www.mjs",
    "add": "cap add android",
    "sync": "cap sync android",
    "build:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/core": "7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9"
  }
}
